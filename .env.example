# ============================================================================
# Dalce Estoque · variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure na Vercel (produção).
# ============================================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Somente servidor: permite ao painel do dono redefinir senhas de clientes.
# NUNCA exponha esta chave no cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Marca / suporte (aparecem na interface)
NEXT_PUBLIC_APP_NAME=Dalce Estoque
NEXT_PUBLIC_APP_URL=https://app.seudominio.com
NEXT_PUBLIC_SUPPORT_EMAIL=suporte@dalce.app
